<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://cinemesh.com/ws/show"
           xmlns:tns="http://cinemesh.com/ws/show"
           elementFormDefault="qualified">

    <xs:complexType name="ShowPricingDto">
        <xs:sequence>
            <xs:element name="category" type="xs:string"/>
            <xs:element name="price" type="xs:double"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ShowDto">
        <xs:sequence>
            <xs:element name="showId" type="xs:long"/>
            <xs:element name="tenantId" type="xs:string"/>
            <xs:element name="theatreName" type="xs:string"/>
            <xs:element name="movieId" type="xs:long"/>
            <xs:element name="movieTitle" type="xs:string"/>
            <xs:element name="screenId" type="xs:long"/>
            <xs:element name="screenName" type="xs:string"/>
            <xs:element name="startTime" type="xs:string"/>
            <xs:element name="endTime" type="xs:string"/>
            <xs:element name="pricing" type="tns:ShowPricingDto" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="ScheduleShowRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="tenantId" type="xs:string"/>
                <xs:element name="movieId" type="xs:long"/>
                <xs:element name="screenId" type="xs:long"/>
                <xs:element name="startTime" type="xs:string"/>
                <xs:element name="standardPrice" type="xs:double"/>
                <xs:element name="premiumPrice" type="xs:double"/>
                <xs:element name="vipPrice" type="xs:double"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ScheduleShowResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="show" type="tns:ShowDto"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetShowsByTenantRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="tenantId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetShowsByTenantResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="shows" type="tns:ShowDto" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetShowDetailsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="showId" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetShowDetailsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="show" type="tns:ShowDto"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
